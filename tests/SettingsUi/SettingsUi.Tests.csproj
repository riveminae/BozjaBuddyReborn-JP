<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.90.1</Version>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(APPDATA)/XIVLauncher/addon/Hooks/dev/</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Configuration.cs" Link="Production/Configuration.cs" />
    <Compile Include="../../Windows/ConfigWindow.cs" Link="Production/ConfigWindow.cs" />
    <Compile Include="../../Windows/RelicWindow.cs" Link="Production/RelicWindow.cs" />
    <Compile Include="../../Game/LostActionCatalog.cs" Link="Production/LostActionCatalog.cs" />
    <Compile Include="../../Game/SurvivalPolicy.cs" Link="Production/SurvivalPolicy.cs" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)Dalamud.Bindings.ImGui.dll" />
    <None Include="$(DalamudLibPath)cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
